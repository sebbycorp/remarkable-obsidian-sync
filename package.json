{
  "name": "obsidian-remarkable-cloud-sync",
  "version": "0.1.0",
  "description": "Sync reMarkable tablet notes to Obsidian via Cloud API",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [
    "obsidian",
    "remarkable",
    "sync",
    "notes"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.10.0",
    "builtin-modules": "^3.3.0",
    "esbuild": "^0.19.0",
    "obsidian": "latest",
    "tslib": "^2.6.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "jszip": "^3.10.1",
    "uuid": "^9.0.0"
  }
}
